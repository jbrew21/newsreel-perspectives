      "voiceName": "Trevor Noah",
      "platform": "x",
      "text": "GOAAALLLLL!!! \ud83c\udde7\ud83c\uddf7\u26bd BRAZIL IS BACK! \ud83d\udd25\n\n#worldcup #brazil\n\nVideo",
