      "type": "tweet"
    },
    {
      "voiceId": "trevor-noah",
      "voiceName": "Trevor Noah",
      "platform": "x",
      "text": "GOAAALLLLL!!! \ud83c\uddf2\ud83c\udde6\u26bd Morocco strikes first!\nAnd just like that... every Brazilian group chat is awake. \ud83d\ude02\n\n#worldcup #brazil #morocco\n\nVideo",
