      "type": "tweet"
    },
    {
      "voiceId": "trevor-noah",
      "voiceName": "Trevor Noah",
      "platform": "x",
      "text": "Maradona. Pel\u00e9. Messi.\n\nThat's John Barnes' top three. Who's in yours? \u26bd\ud83d\udc47\n\n#worldcup #brazil #morocco\n\nVideo",
      "sourceUrl": "https://x.com/Trevornoah/status/2065936931754738132",
