      "type": "tweet"
    },
    {
      "voiceId": "trevor-noah",
      "voiceName": "Trevor Noah",
      "platform": "x",
      "text": "Ohhh my Brazilian friends...\nThey told me, \"If you love Brazil, don't wear the jersey today.\" \ud83d\ude02\n\n#worldcup #brasil #brazil\n\nVideo",
      "sourceUrl": "https://x.com/Trevornoah/status/2065923105315508301",
