    {
      "voiceId": "trevor-noah",
      "voiceName": "Trevor Noah",
      "platform": "x",
      "text": "It\u2019s fascinating how a drug designed for weight loss is suddenly making people rethink shopping, drinking, gambling, social media\u2026 even pleasure itself.\n\nVideo",
      "sourceUrl": "https://x.com/Trevornoah/status/2060882702249910489",
