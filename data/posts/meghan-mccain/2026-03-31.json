      "type": "tweet"
    },
    {
      "voiceId": "meghan-mccain",
      "voiceName": "Meghan McCain",
      "platform": "x",
      "text": "South Carolina is a very proper, cultured, extremely influential and important state in American politics - they can do so much better than Lindsey Graham holding a bubble wand at Disney World to represent their state.",
      "sourceUrl": "https://x.com/MeghanMcCain/status/2038712969878437902",
