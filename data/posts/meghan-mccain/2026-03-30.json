      "voiceName": "Meghan McCain",
      "platform": "x",
      "text": "The men and women of the TSA deserve so much better than this shit.",
      "sourceUrl": "https://x.com/MeghanMcCain/status/2037608827512566006",
      "timestamp": "2026-03-27T19:12:56+00:00",
