    {
      "voiceId": "meghan-mccain",
      "voiceName": "Meghan McCain",
      "platform": "x",
      "text": "Give @TMZ a White House press badge for the briefing room. I am not joking.",
      "sourceUrl": "https://x.com/MeghanMcCain/status/2044058012399108167",
      "timestamp": "2026-04-14T14:19:41+00:00",
      "type": "tweet"
