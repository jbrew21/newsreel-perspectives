    },
    {
      "voiceId": "meghan-mccain",
      "voiceName": "Meghan McCain",
      "platform": "x",
      "text": "It was a great weekend to be an American \ud83c\uddfa\ud83c\uddf8\u2764\ufe0f\n\nToday at noon ET: Recapping UFC, World Cup, and Europeans discovering all of America's greatest treasures.\n\nJoin me &amp; @bungarsargon LIVE! piped.video/mzTC90Z2u4s",
