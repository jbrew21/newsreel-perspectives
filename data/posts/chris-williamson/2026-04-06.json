    {
      "voiceId": "chris-williamson",
      "voiceName": "Chris Williamson",
      "platform": "x",
      "text": "Self-Respect Comes From Having Faith In Your Own Word\n\nVideo",
      "sourceUrl": "https://x.com/ChrisWillx/status/2038633307819089988",
      "timestamp": "2026-03-30T15:03:51+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "chris-williamson",
      "voiceName": "Chris Williamson",
      "platform": "x",
      "text": "\u201cMen are more expendable than women, probably for basic biological reasons. If a small group loses half its men, the next generation can still be full size, but if it loses half its women, it'll be a long time to recover.\u201d \u2014 Roy Baumeister\n\n\ud83d\udd17 open.spotify.com/episode/3XX\u2026",
      "sourceUrl": "https://x.com/ChrisWillx/status/2038350828646404340",
      "timestamp": "2026-03-29T20:21:22+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "chris-williamson",
      "voiceName": "Chris Williamson",
      "platform": "x",
      "text": "The World Is There For The Taking\n\nVideo",
      "sourceUrl": "https://x.com/ChrisWillx/status/2038261371939262567",
      "timestamp": "2026-03-29T14:25:54+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "chris-williamson",
      "voiceName": "Chris Williamson",
      "platform": "x",
      "text": "The higher you climb, the further you have to fall.\n\n\u201cI have a hard time celebrating my achievements because in my mind it was my obligation to achieve it.\u201d \u2014 Michael Smoak",
