    {
      "voiceId": "chris-williamson",
      "voiceName": "Chris Williamson",
      "platform": "x",
      "text": "A renaissance conspiracy.\n\n\u201cOne conspiracy I believe in is that old artists were secretly allowed to depict male nudity only if they kept their dicks small, so women would assume that was normal and that their husbands were thus abnormally huge.\u201d \u2014 @JasonKPargin",
      "sourceUrl": "https://x.com/ChrisWillx/status/2041942247017525442",
      "timestamp": "2026-04-08T18:12:23+00:00",
      "type": "tweet"
    },
    {
