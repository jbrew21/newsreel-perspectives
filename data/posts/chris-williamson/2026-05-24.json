    {
      "voiceId": "chris-williamson",
      "voiceName": "Chris Williamson",
      "platform": "x",
      "text": "Let go or be dragged.\n\nIf it doesn\u2019t fit, eventually it\u2019ll hurt wearing it.",
      "sourceUrl": "https://x.com/ChrisWillx/status/2058291883009597489",
      "timestamp": "2026-05-23T21:00:00+00:00",
