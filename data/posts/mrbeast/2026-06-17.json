      "timestamp": "2026-06-13T16:14:15+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "mrbeast",
      "voiceName": "MrBeast",
      "platform": "x",
      "text": "WE HIT HALF A BILLION SUBSCRIBERS \u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f\u2764\ufe0f",
