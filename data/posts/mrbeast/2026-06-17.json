      "voiceName": "MrBeast",
      "platform": "x",
      "text": "I\u2019m confused, @KSI did you actually leave the sidemen??",
      "sourceUrl": "https://x.com/MrBeast/status/2061442018497458361",
      "timestamp": "2026-06-01T13:37:31+00:00",
