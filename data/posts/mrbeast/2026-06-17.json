      "timestamp": "2026-06-12T15:08:57+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "mrbeast",
      "voiceName": "MrBeast",
      "platform": "x",
      "text": "With 500,000,000 subscribers coming up, I invited all the creators that inspired me growing up to celebrate in this Saturday\u2019s video :D\n\nVideo",
      "sourceUrl": "https://x.com/MrBeast/status/2065224386219491490",
      "timestamp": "2026-06-12T00:07:18+00:00",
      "type": "tweet"
    },
    {
