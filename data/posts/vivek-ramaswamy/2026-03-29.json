      "type": "tweet"
    },
    {
      "voiceId": "vivek-ramaswamy",
      "voiceName": "Vivek Ramaswamy",
      "platform": "x",
      "text": "Slashing property taxes = More $$ in your pocket.\n\nVideo",
      "sourceUrl": "https://x.com/VivekGRamaswamy/status/2037565467104248294",
      "timestamp": "2026-03-27T16:20:38+00:00",
      "type": "tweet"
