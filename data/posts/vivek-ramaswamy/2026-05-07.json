      "type": "tweet"
    },
    {
      "voiceId": "vivek-ramaswamy",
      "voiceName": "Vivek Ramaswamy",
      "platform": "x",
      "text": "I know the American Dream exists because I\u2019ve lived it. And we\u2019re going to revive that American Dream right here in Ohio for the next generation - starting next year.\n\nVideo",
      "sourceUrl": "https://x.com/VivekGRamaswamy/status/2051765018967031853",
