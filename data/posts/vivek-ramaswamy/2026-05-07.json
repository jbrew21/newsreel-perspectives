      "timestamp": "2026-05-05T21:52:26+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "vivek-ramaswamy",
      "voiceName": "Vivek Ramaswamy",
      "platform": "x",
      "text": "Believe in your country &amp; believe in yourself. The #1 factor that determines whether you achieve your goals in life is actually you.\n\nVideo",
