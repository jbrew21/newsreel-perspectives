      "voiceName": "Vivek Ramaswamy",
      "platform": "x",
      "text": "\ud83d\udd34 LIVE: Primary Victory Party nitter.net/i/broadcasts/1AKEmOQwB\u2026",
      "sourceUrl": "https://x.com/VivekGRamaswamy/status/2051813020016480564",
      "timestamp": "2026-05-05T23:55:19+00:00",
      "type": "tweet"
