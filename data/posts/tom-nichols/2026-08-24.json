    },
    {
      "voiceId": "tom-nichols",
      "voiceName": "Tom Nichols",
      "platform": "bluesky",
      "text": "I adored Time Tunnel. It doesn't hold up well now, sadly.",
      "sourceUrl": "https://bsky.app/profile/radiofreetom.bsky.social/post/3mtsawrjmx225",
      "timestamp": "2026-08-24T02:27:15.460Z",
