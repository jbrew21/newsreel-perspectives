      "voiceName": "Patrick Bet-David",
      "platform": "x",
      "text": "The bigger the vision, the more enemies you\u2019ll attract. Get used to it.",
      "sourceUrl": "https://x.com/patrickbetdavid/status/2046203225544511950",
      "timestamp": "2026-04-20T12:24:00+00:00",
      "type": "tweet"
    },
    {
