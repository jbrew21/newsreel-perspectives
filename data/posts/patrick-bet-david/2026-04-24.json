      "voiceName": "Patrick Bet-David",
      "platform": "x",
      "text": "Confidence comes from keeping promises to yourself.",
      "sourceUrl": "https://x.com/patrickbetdavid/status/2046596063839355148",
      "timestamp": "2026-04-21T14:25:00+00:00",
      "type": "tweet"
