      "platform": "x",
      "text": "\u0645\u0631\u062f\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0648 \u062e\u0627\u0646\u0648\u0627\u062f\u0647\u200c\u0647\u0627\u0645\u0648\u0646 \u062e\u06cc\u0644\u06cc \u062f\u0644\u0645\u0648\u0646 \u0628\u0631\u0627\u062a\u0648\u0646 \u062a\u0646\u06af \u0634\u062f\u0647 \u0628\u0648\u062f \ud83e\udd7a",
