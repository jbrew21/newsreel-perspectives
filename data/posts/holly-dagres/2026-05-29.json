    {
      "voiceId": "holly-dagres",
      "voiceName": "Holly Dagres",
      "platform": "x",
      "text": "\u067e\u0633\u0631 \u0627\u06cc\u0631\u0627\u0646 \ud83e\udd0d\n\n\n\u062a\u0648\u0645\u0627\u062c \u0635\u0627\u0644\u062d\u06cc\ud83c\udf0b (@OfficialToomaj)\n\n\u0628\u0639\u062f \u0627\u0632 \u0633\u0647 \u0645\u0627\u0647 \u0642\u0637\u0639\u06cc\u0650 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u060c \u062a\u0633\u0644\u06cc\u062a \u0645\u06cc\u06af\u0645 \u0628\u0647 \u062e\u0627\u0646\u0648\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0642\u0631\u0628\u0627\u0646\u06cc\u0627\u0646\u060c \u0686\u0647 \u0645\u0631\u062f\u0645 \u0628\u06cc\u200c\u06af\u0646\u0627\u0647\u06cc \u06a9\u0647 \u062f\u0631 \u062c\u0646\u06af \u06a9\u0634\u062a\u0647 \u0634\u062f\u0646\u062f\u060c \u0645\u062b\u0644 \u00ab\u0641\u0631\u0634\u062a\u0647\u200c\u0647\u0627\u06cc \u0645\u06cc\u0646\u0627\u0628\u00bb \u0686\u0647 \u06a9\u0633\u0627\u0646\u06cc \u06a9\u0647 \u0627\u0639\u062f\u0627\u0645 \u0634\u062f\u0646\u062f.\n\u0648 \u0639\u0645\u06cc\u0642\u0627\u064b \u0645\u062a\u0623\u0633\u0641\u0645 \u0628\u0627\u0628\u062a \u0641\u0634\u0627\u0631\u0647\u0627\u06cc \u0627\u0642\u062a\u0635\u0627\u062f\u06cc \u0646\u0627\u0634\u06cc \u0627\u0632 \u062c\u0646\u06af \u0627\u0645\u0627 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631\u0645 \u0628\u0647 \u0641\u0631\u062f\u0627\u06cc \u0631\u0648\u0634\u0646\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc\u0645 \u0628\u0627 \u0647\u0645 \u0628\u0647\u0634 \u0628\u0631\u0633\u06cc\u0645.\n\u0646\u06a9\u062a\u0647\u200c\u06cc \u062f\u06cc\u06af\u0647\u200c\u0627\u06cc \u06a9\u0647 \u0644\u0627\u0632\u0645 \u0628\u0647 \u06af\u0641\u062a\u0646 \u0645\u06cc\u200c\u062f\u0648\u0646\u0645:\n\u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc \u06a9\u0647 \u062f\u06cc\u0631\u0648\u0632 \u0648\u0635\u0644 \u0634\u062f\u060c \u0644\u0637\u0641\u06cc \u0628\u0647 \u0645\u0627 \u0646\u06cc\u0633\u062a\u060c \u0628\u0644\u06a9\u0647 \u062d\u0642\u0650 \u0645\u0627\u0633\u062a\u060c \u0627\u0648\u0646 \u0647\u0645 \u0628\u062f\u