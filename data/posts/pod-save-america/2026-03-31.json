      "timestamp": "2026-03-27T14:31:00+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "pod-save-america",
      "voiceName": "Pod Save America",
      "platform": "x",
      "text": "Jon Favreau and Jon Lovett on Trump\u2019s statement following the death of Robert Mueller.\n\nVideo",
      "sourceUrl": "https://x.com/PodSaveAmerica/status/2036507042693652913",
      "timestamp": "2026-03-24T18:14:50+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "pod-save-america",
      "voiceName": "Pod Save America",
      "platform": "x",
      "text": "We went from regime change to joint custody of the Strait of Hormuz.\n\nVideo",
