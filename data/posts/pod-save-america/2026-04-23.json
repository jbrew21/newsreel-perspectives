      "timestamp": "2026-04-17T12:30:50+00:00",
      "type": "tweet"
    },
    {
      "voiceId": "pod-save-america",
      "voiceName": "Pod Save America",
      "platform": "x",
      "text": "Pete Hegseth thought he was reading aloud from the bible. He was reading lines from Pulp Fiction.\n\nVideo",
