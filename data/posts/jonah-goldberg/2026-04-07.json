      "type": "post"
    },
    {
      "voiceId": "jonah-goldberg",
      "voiceName": "Jonah Goldberg",
      "platform": "bluesky",
      "text": "\u201cGood morning. It\u2019s Friday. Don\u2019t be frightened by my collar. It\u2019s for scaring away mean dogs. At least that\u2019s what they told me. Also, I love you.\u201d",
      "sourceUrl": "https://bsky.app/profile/jonahg.bsky.social/post/3lc3kvgrpqs24",
      "timestamp": "2024-11-29T12:19:44.310Z",
      "type": "post"
    },
    {
      "voiceId": "jonah-goldberg",
      "voiceName": "Jonah Goldberg",
      "platform": "bluesky",
      "text": "I forgot I\u2019ve had an account here since 2023. Kicking the tires now.",
      "sourceUrl": "https://bsky.app/profile/jonahg.bsky.social/post/3lbv53f2eg625",
      "timestamp": "2024-11-26T22:56:33.008Z",
      "type": "post"
    },
    {
