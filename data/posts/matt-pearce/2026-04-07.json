    },
    {
      "voiceId": "matt-pearce",
      "voiceName": "Matt Pearce",
      "platform": "bluesky",
      "text": "It\u2019s fun\u2014a macabre sort of fun\u2014this parlor game of \u201cWho Goes AI?\u201d And it simplifies things\u2014asking the question in regard to specific journalists.\n\nwww.todayintabs.com/p/who-goes-ai",
      "sourceUrl": "https://bsky.app/profile/mattdpearce.com/post/3mihivphj5k2i",
      "timestamp": "2026-04-01T20:13:24.646Z",
      "type": "post"
    },
    {
