      "type": "tweet"
    },
    {
      "voiceId": "sneako",
      "voiceName": "SNEAKO",
      "platform": "x",
      "text": "In Asia they called me black\nIn Africa they called me white\nIn America they say I am brown\nIn Arabia they say I look yellow\nTo Allah I am none but Muslim",
