      "type": "tweet"
    },
    {
      "voiceId": "sneako",
      "voiceName": "SNEAKO",
      "platform": "x",
      "text": "That concludes the SEA tour! Thank you for tuning and supporting the past few weeks. \n\ud83c\uddf5\ud83c\udded\ud83c\uddf2\ud83c\uddfe\ud83c\uddee\ud83c\udde9",
      "sourceUrl": "https://x.com/sneako/status/2049814766680469610",
