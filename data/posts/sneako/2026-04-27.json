      "type": "tweet"
    },
    {
      "voiceId": "sneako",
      "voiceName": "SNEAKO",
      "platform": "x",
      "text": "In one week I brought the Prime Minister and the Prince of Malaysia on stream \n\nThank you for hosting me \nPhilippines next- my motherland",
