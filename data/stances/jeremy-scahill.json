          "quote": "\u26a1\ufe0f \u062d\u0635\u0631\u064a: \u062d\u0635\u0644\u062a \u0645\u0646\u0635\u0629 \u062f\u0631\u0648\u0628 \u0633\u0627\u064a\u062a \u0646\u064a\u0648\u0632 \u0639\u0644\u0649 \u0648\u062b\u064a\u0642\u062a\u064a\u0646 \u0645\u0646 \u0623\u062d\u062f\u062b \u062c\u0648\u0644\u0629 \u0645\u0641\u0627\u0648\u0636\u0627\u062a \u0628\u0634\u0623\u0646 \u0645\u0633\u062a\u0642\u0628\u0644 \u063a\u0632\u0629:\n\n1. \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u0642\u062f\u0645\u0647\u0627 \u0627\u0644\u0645\u0641\u0627\u0648\u0636\u0648\u0646 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a\u0648\u0646 \u0639\u0644\u0649 \u062e\u0627\u0631\u0637\u0629 \u0627\u0644\u0637\u0631\u064a\u0642 \u0627\u0644\u0645\u0642\u062a\u0631\u062d\u0629 \u0645\u0646 \"\u0645\u062c\u0644\u0633 \u0627\u0644\u0633\u0644\u0627\u0645\"\u060c \u0648\u0627\u0644\u062a\u064a \u0633\u064f\u0644\u0651\u0645\u062a \u0641\u064a 13 \u064a\u0648\u0646\u064a\u0648.\n\n2. \u0627\u0644\u0631\u062f \u0627\u0644\u0630\u064a \u0642\u062f\u0645\u0647 \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0627\u0636\u064a \"\u0627\u0644\u0645\u0645\u062b\u0644 \u0627\u0644\u0633\u0627\u0645\u064a\" \u0644\u0644\u0645\u062c\u0644\u0633\u060c \u0646\u064a\u0643\u0648\u0644\u0627\u064a \u0645\u0644\u0627\u062f\u064a\u0646\u0648\u0641.\n\n\u0623\u0628",
