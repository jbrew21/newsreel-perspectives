          "quote": "\u0627\u0644\u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a\u0629\n\n\ud83d\udd39 \u064a\u0624\u0643\u062f \u0627\u0644\u0645\u0642\u062a\u0631\u062d \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a \u0623\u0646 \u0623\u064a \u062d\u0644 \u0644\u0645\u0633\u0623\u0644\u0629 \u0627\u0644\u0633\u0644\u0627\u062d \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u062c\u0632\u0621\u064b\u0627 \u0645\u0646 \u0645\u0633\u0627\u0631 \u0633\u064a\u0627\u0633\u064a \u0623\u0634\u0645\u0644 \u064a\u0636\u0645\u0646 \u062d\u0642 \u0627\u0644\u0634\u0639\u0628 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a \u0641\u064a \u0625\u0642\u0627\u0645\u0629 \u062f\u0648\u0644\u062a\u0647 \u0648\u0645\u0645\u0627\u0631\u0633\u0629 \u062d\u0642\u0647 \u0641\u064a \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u0635\u064a\u0631.\n\n\ud83d\udd38 \u0641\u064a \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u060c \u062a\u0643\u062a\u0641\u064a \u0645\u0633\u0648\u062f\u0629 \"\u0645\u062c\u0644\u0633 \u0627\u0644\u0633\u0644\u0627\u0645\" \u0628\u0627\u0644\u0642\u0648\u0644 \u0625\u0646 \u0646\u0632\u0639 \u0627\u0644\u0633\u0644\u0627\u062d \"\u0633\u064a\u0648\u0641\u0631 \u0627\u0644\u0638\u0631\u0648\u0641 \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0644\u0645\u0633\u0627\u0631 \u0645\u0648\u062b\u0648\u0642.\"\n\n",
